# Kubernetes Secret Generator - Environment Configuration Template
# Copy this file to .env and configure for your environment

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=false

# Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Application Settings
SECRET_NAME_DEFAULT=my-secret
NAMESPACE_DEFAULT=default

# Security Configuration
# Maximum content length in bytes (default: 1048576 = 1MB)
MAX_CONTENT_LENGTH=1048576

# Rate limiting (format: "N per minute/hour/day")
RATE_LIMIT=10 per minute

# Enable security headers (true/false)
ENABLE_SECURITY_HEADERS=true
